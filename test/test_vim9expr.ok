(vim9script)
(var = d (dict ('key' 1) ('q' 2) ("dq" 3) ((+ 1 1) 4) ('09' 5) ('a-b' 6)))
(var = e (dict))
(var = g (concat (concat g:foo b:bar) v:true))
(var = l (list 1 2))
(var = m (dict ('a' 1) ('b' (list 1 2))))
(var = text (concat (concat 'V' 'i') 'm'))
(var = version (+ (* 9 100) 2))
(var = latest (?: (== v:version 902) 'current' 'out-of-date'))
(var = s (concat (dot d key) (dot d q)))
(var = r (method (list 1 2) (reverse)))
(var = call (Foo 1 2))
(var = slice (slice l 1 2))
(var = nested (dot (subscript (dot (dot d a) b) 0) c))
(echo "done")
