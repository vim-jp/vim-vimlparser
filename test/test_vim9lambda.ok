(vim9script)
(var = F1 (lambda (n) (+ n 1)))
(var = F2 (lambda (n) (+ n 1)))
(var = F3 (lambda () 0))
(var = F4 (lambda (_ val) (> val 0)))
(var = F5 (lambda (...args) (var = opts (dict)) (for arg args (echo arg)) (return opts)))
(var = timer (timer_start 700 (lambda (_) (echo 'x')) (dict ('repeat' 3))))
(var = t0 (tuple))
(var = t1 (tuple 1))
(var = t2 (tuple 1 'a' (list 2)))
(var = p (* (+ 1 2) 3))
(var = c (list 1 (cast <number> g:two)))
(var = m (method (list 3 1) (sort (lambda (a b) (- a b)))))
