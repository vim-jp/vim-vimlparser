(vim9script)
(var = n 0)
(var = l (list 1 2))
(var = d (dict ('a' 1)))
(assign = n 2)
(assign += n 1)
(assign ..= n 'x')
(assign = (subscript l 0) 3)
(assign = (slice l 0 1) (list 4 5))
(assign = (dot d a) 2)
(assign = (subscript d 'b') 3)
(assign = (n l) (list 1 (list 2)))
(assign = (n . l) (list 1 2 3))
(assign = g:var 1)
(assign = b:var 2)
(assign = &tabstop 8)
(assign = &l:shiftwidth 2)
(assign = $ENV 'x')
(assign = @a 'reg')
(assign ++ n)
(assign -- n)
(call (Foo))
(call (g:Foo 1 2))
(eval (method l (add 3)))
(eval (method l (add 4)))
(eval (method 'text' (setline 1)))
(eval (method "text" (setline 1)))
(eval (method (list 1 2) (len)))
(eval (method (dict ('a' 1)) (len)))
(eval (method (+ 1 2) (string)))
(eval (method 0z1234 (len)))
(eval (method 123 (string)))
(call (foo#bar#Baz))
(call (Generic<number> 1))
(var = lines (list))
(assign =<< lines (heredoc (list "trim") "END" (list "  one")))
(assign = n 1)
; comment
(call (Foo))
(excmd "nnoremap = <Nop>")
(echo n)
(excmd "%s/a/b/g")
(excmd "1,2d")
(block
  (echo 'block'))
(excmd "silent! :%delete _")
(if 1)
;}}}
