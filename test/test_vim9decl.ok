(vim9script)
(var a: any)
(var b: bool)
(var s: string)
(var = l: list<dict<number>> (list))
(var = (first _ last) (list 'A' 'M' 'Z'))
(var = (name _ country . _) (GetNameCountry))
(var = (d: number e: string . rest) (tuple 1 'I' 'one'))
(var =<< lines (heredoc (list "trim") "END" (list "  text")))
(final = f: list<number> (list 7))
(const = NAMES (list 'Paul' 'Mary'))
(const = I09: func: number (lambda (n) (+ n 1)))
(const = I12: func(number): number (lambda (n) (+ n 1)))
(var = t: tuple<number, string> (tuple 1 'a'))
(for x: number (list 1 2)
  (echo x))
(for (k: string v: any) (items (dict))
  (echo k v))
(for b:i (list 1 2 3))
(var count: number)
(assign += count 1)
(excmd "var")
